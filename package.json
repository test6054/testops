{
  "name": "edu-practice-mark-vue",
  "type": "module",
  "version": "1.0.0",
  "private": "true",
  "description": "阅卷中心 Web - 对接 edu-mark / edu-user / edu-storage",
  "scripts": {
    "bootstrap": "pnpm install --registry=https://registry.npmmirror.com",
    "dev": "node scripts/kill-port.js 5273 && vite --host --port 5273",
    "dev:simple": "vite --host --port 5273",
    "kill-port": "node scripts/kill-port.js",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:test": "vue-tsc -p tsconfig.app.json --noEmit && vite build --mode test",
    "preview": "vite preview --port 5050",
    "typecheck": "pnpm exec vue-tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@vueuse/components": "^14.2.1",
    "@vueuse/core": "^14.2.1",
    "aieditor": "^1.4.2",
    "animate.css": "^4.1.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.13.6",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.1",
    "echarts": "^6.0.0",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.23",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.29",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.3",
    "xe-utils": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "7.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.0",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/tsconfig": "^0.9.0",
    "boxen": "^8.0.1",
    "eslint": "^9.39.3",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "typescript": "~5.8.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-compression2": "^2.5.0",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vue-tsc": "^3.2.9"
  },
  "pnpm": {
    "overrides": {
      "eslint-flat-config-utils": "3.0.1"
    }
  }
}
